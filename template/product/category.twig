{{ header }}
<div id="product-category" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    <div id="content" class="col">{{ content_top }}
      <h1 class="mb-4">{{ heading_title }}</h1>
      {% if image or description %}
        <div class="row">
          {% if image %}
            <div class="col-12 col-sm-3 text-center text-sm-start"><img src="{{ image }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-thumbnail img-fluid"/></div>
          {% endif %}
          {% if description %}
            <div class="{% if image %}col-12 col-sm-9{% else %}col-12{% endif %}">{{ description }}</div>
          {% endif %}
        </div>
        <hr/>
      {% endif %}

      {% if categories %}
        <h2 class="h4 mb-3">{{ text_refine }}</h2>
        <ul class="list-unstyled d-flex flex-wrap gap-2 mb-4">
          {% for category in categories %}
            <li><a href="{{ category.href }}" class="btn btn-light">{{ category.name }}</a></li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if products %}
        <div class="row align-items-end g-2 mb-3">
          <div class="col-12 col-sm-8 col-lg-3">
            <div class="mb-0">
              <a href="{{ compare }}" id="compare-total" class="btn btn-primary d-block"><i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i> <span class="d-inline">{{ text_compare }}</span></a>
            </div>
          </div>
          <div class="col-12 col-sm-4 col-lg-2">
            <div class="btn-group w-100">
              <button type="button" id="button-list" class="btn btn-light" data-bs-toggle="tooltip" title="{{ button_list }}" aria-label="{{ button_list }}"><i class="fa-solid fa-table-list" aria-hidden="true"></i></button>
              <button type="button" id="button-grid" class="btn btn-light" data-bs-toggle="tooltip" title="{{ button_grid }}" aria-label="{{ button_grid }}"><i class="fa-solid fa-table-cells" aria-hidden="true"></i></button>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-lg-4">
            <div class="input-group mb-0">
              <label for="input-sort" class="input-group-text">{{ text_sort }}</label>
              <select id="input-sort" class="form-select" onchange="location = this.value;">
                {% for sorts in sorts %}
                  <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ sorts.text }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <div class="input-group mb-0">
              <label for="input-limit" class="input-group-text">{{ text_limit }}</label>
              <select id="input-limit" class="form-select" onchange="location = this.value;">
                {% for limits in limits %}
                  <option value="{{ limits.href }}"{% if limits.value == limit %} selected{% endif %}>{{ limits.text }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
        </div>

        <div id="product-list" class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-4">
          {% for product in products %}
            <div class="col mb-3">{{ product }}</div>
          {% endfor %}
        </div>

        <div class="row align-items-center gy-2 mt-3">
          <div class="col-sm-6 text-start">{{ pagination }}</div>
          <div class="col-sm-6 text-start text-sm-end">{{ results }}</div>
        </div>
      {% endif %}
      {% if not categories and not products %}
        <p class="p-4 bg-white border rounded-3" role="status">{{ text_no_results }}</p>
        <div class="text-end"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      {% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
