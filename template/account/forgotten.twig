{{ header }}
<div id="account-forgotten" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    <div id="content" class="col">{{ content_top }}
      <h1 class="mb-4">{{ heading_title }}</h1>
      <p>{{ text_email }}</p>
      <form id="form-forgotten" action="{{ confirm }}" method="post" data-oc-toggle="ajax" class="p-3 p-md-4 bg-white border rounded-3 mb-4">
        <fieldset>
          <legend class="h5 pb-3">{{ text_your_email }}</legend>
          <div class="row g-2 mb-3 required">
            <label for="input-email" class="col-12 col-md-3 col-form-label text-start">{{ entry_email }}</label>
            <div class="col-12 col-md-9">
              <input type="text" name="email" value="" placeholder="{{ entry_email }}" id="input-email" class="form-control" autocomplete="email" inputmode="email" aria-describedby="error-email"/>
              <div id="error-email" class="invalid-feedback"></div>
            </div>
          </div>
        </fieldset>
        <div class="row g-2">
          <div class="col-12 col-sm-6">
            <a href="{{ back }}" class="btn btn-light w-100">{{ button_back }}</a>
          </div>
          <div class="col-12 col-sm-6 text-end">
            <button type="submit" class="btn btn-primary w-100">{{ button_continue }}</button>
          </div>
        </div>
      </form>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}