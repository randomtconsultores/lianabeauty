{{ header }}
<div id="account-reset" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    <div id="content" class="col">{{ content_top }}
      <h1 class="mb-4">{{ heading_title }}</h1>
      <form id="form-reset" action="{{ save }}" method="post" data-oc-toggle="ajax" class="p-3 p-md-4 bg-white border rounded-3 mb-4">
        <fieldset>
          <legend class="h5 pb-3">{{ text_password }}</legend>
          <div class="row g-2 mb-3">
            <label for="input-password" class="col-12 col-md-3 col-form-label text-start">{{ entry_password }}</label>
            <div class="col-12 col-md-9">
              <input type="password" name="password" value="" id="input-password" class="form-control" autocomplete="new-password" aria-describedby="error-password"/>
              <div id="error-password" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row g-2 mb-3">
            <label for="input-confirm" class="col-12 col-md-3 col-form-label text-start">{{ entry_confirm }}</label>
            <div class="col-12 col-md-9">
              <input type="password" name="confirm" value="" id="input-confirm" class="form-control" autocomplete="new-password" aria-describedby="error-confirm"/>
              <div id="error-confirm" class="invalid-feedback"></div>
            </div>
          </div>
        </fieldset>
        <div class="row g-2">
          <div class="col-12 col-sm-6">
            <a href="{{ back }}" class="btn btn-light w-100">{{ button_back }}</a>
          </div>
          <div class="col-12 col-sm-6 text-end">
            <button type="submit" class="btn btn-primary w-100">{{ button_continue }}</button>
          </div>
        </div>
      </form>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
