<style>
/* One set of cart fields: cards on mobile/tablet, table on desktop. */
#checkout-cart #output-cart .lb-cart-label { display: none; }
@media (max-width: 991.98px) {
  #checkout-cart #output-cart.lb-cart-output { overflow: visible; background: transparent !important; border: 0 !important; }
  #checkout-cart #output-cart .lb-cart-table { display: block; border: 0; }
  #checkout-cart #output-cart .lb-cart-table > thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  #checkout-cart #output-cart .lb-cart-table > tbody { display: grid; gap: 1rem; }
  #checkout-cart #output-cart .lb-cart-table > tbody > tr { display: grid; grid-template-columns: 72px minmax(0, 1fr); grid-template-areas: "image name" "quantity quantity" "price price" "total total"; gap: .75rem; min-width: 0; padding: 1rem; background: #fff; border: 1px solid var(--lb-line); border-radius: .75rem; }
  #checkout-cart #output-cart .lb-cart-table > tbody > tr > td { display: block; min-width: 0; padding: 0; border: 0; box-shadow: none; overflow-wrap: anywhere; }
  #checkout-cart #output-cart .lb-cart-image { grid-area: image; }
  #checkout-cart #output-cart .lb-cart-image img { width: 72px; max-width: 100%; height: 72px; object-fit: contain; }
  #checkout-cart #output-cart .lb-cart-name { grid-area: name; }
  #checkout-cart #output-cart .lb-cart-name > a { color: var(--lb-ink); font-weight: 650; }
  #checkout-cart #output-cart .lb-cart-quantity { grid-area: quantity; }
  #checkout-cart #output-cart .lb-cart-label { display: block; color: var(--lb-muted); font-size: .875rem; }
  #checkout-cart #output-cart .lb-cart-quantity .lb-cart-label { margin-bottom: .35rem; }
  #checkout-cart #output-cart .lb-cart-quantity .input-group { max-width: 320px; flex-wrap: nowrap; }
  #checkout-cart #output-cart .lb-cart-quantity .form-control { min-width: 0; font-size: 16px; }
  #checkout-cart #output-cart .lb-cart-quantity .btn { min-width: 44px; min-height: 44px; }
  #checkout-cart #output-cart .lb-cart-table > tbody > tr > .lb-cart-unit-price,
  #checkout-cart #output-cart .lb-cart-table > tbody > tr > .lb-cart-line-total { display: flex; justify-content: space-between; align-items: baseline; gap: .75rem; white-space: normal !important; }
  #checkout-cart #output-cart .lb-cart-unit-price { grid-area: price; }
  #checkout-cart #output-cart .lb-cart-line-total { grid-area: total; }
  #checkout-cart #output-cart #checkout-total { display: block; margin-top: 1rem; padding: 1rem; background: #fff; border: 1px solid var(--lb-line); border-radius: .75rem; }
  #checkout-cart #output-cart #checkout-total > tr { display: flex; justify-content: space-between; gap: 1rem; border: 0; }
  #checkout-cart #output-cart #checkout-total > tr > td { display: block; min-width: 0; padding: .35rem 0; border: 0; box-shadow: none; overflow-wrap: anywhere; }
  #checkout-cart #output-cart #checkout-total > tr > td:first-child { text-align: start !important; }
}
</style>
{% if products %}
  {% if error_warning %}
    <div class="alert alert-danger alert-dismissible" role="alert"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  {% if error_stock %}
    <div class="alert alert-danger alert-dismissible" role="alert"><i class="fa-solid fa-circle-exclamation"></i> {{ error_stock }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  {% if success %}
    <div class="alert alert-success alert-dismissible" role="status"><i class="fa-solid fa-circle-check"></i> {{ success }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  {% if attention %}
    <div class="alert alert-info" role="status"><i class="fa-solid fa-circle-info"></i> {{ attention }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  <h1 class="mb-4">{{ heading_title }}{% if weight %} ({{ weight }}){% endif %}</h1>
  <div id="output-cart" class="table-responsive bg-white border rounded-3 mb-4 lb-cart-output">
    <table class="table table-bordered align-middle mb-0 lb-cart-table" role="table">
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col" class="text-center">{{ column_image }}</th>
          <th role="columnheader" scope="col">{{ column_name }}</th>
          <th role="columnheader" scope="col">{{ column_quantity }}</th>
          <th role="columnheader" scope="col" class="text-end">{{ column_price }}</th>
          <th role="columnheader" scope="col" class="text-end">{{ column_total }}</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {% for product in products %}
          <tr role="row">
            <td role="cell" class="text-center lb-cart-image">{% if product.thumb %}<a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-thumbnail border-0" decoding="async"/></a>{% endif %}</td>
            <td role="cell" class="text-start text-wrap lb-cart-name"><a href="{{ product.href }}">{{ product.name }}</a>{% if not product.stock %} <span class="text-danger">***</span>{% endif %}
              <ul class="list-unstyled mb-0">
                {% for option in product.option %}
                  <li>
                    <small>{{ option.name }}: {{ option.value }}</small>
                  </li>
                {% endfor %}
                {% if product.subscription %}
                  <li>
                    <small>{{ text_subscription }}: {{ product.subscription }}</small>
                  </li>
                {% endif %}
              </ul>
            </td>
            <td role="cell" class="lb-cart-quantity">
              <span class="lb-cart-label" aria-hidden="true">{{ column_quantity }}</span>
              <form method="post" data-oc-target="#shopping-cart">
                <div class="input-group">
                  <input type="text" name="quantity" value="{{ product.quantity }}" size="1" id="input-cart-quantity-{{ loop.index }}" inputmode="numeric" aria-label="{{ column_quantity }}: {{ product.name }}"{% if product.minimum %} aria-describedby="error-cart-quantity-{{ loop.index }}"{% endif %} class="form-control{% if product.minimum %} is-invalid{% endif %}"/>
                  <input type="hidden" name="key" value="{{ product.cart_id }}"/>
                  <button type="submit" formaction="{{ edit }}" data-bs-toggle="tooltip" title="{{ button_update }}" aria-label="{{ button_update }}: {{ product.name }}" class="btn btn-primary"><i class="fa-solid fa-rotate" aria-hidden="true"></i></button>
                  <a href="{{ product.remove }}" data-bs-toggle="tooltip" title="{{ button_remove }}" aria-label="{{ button_remove }}: {{ product.name }}" class="btn btn-danger"><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i></a>
                </div>
              </form>
              {% if product.minimum %}
                <small id="error-cart-quantity-{{ loop.index }}" class="invalid-feedback d-block">{{ product.minimum }}</small>
              {% endif %}</td>
            <td role="cell" class="text-end text-nowrap lb-cart-unit-price"><span class="lb-cart-label" aria-hidden="true">{{ column_price }}</span><span>{{ product.price }}</span></td>
            <td role="cell" class="text-end text-nowrap lb-cart-line-total"><span class="lb-cart-label" aria-hidden="true">{{ column_total }}</span><strong>{{ product.total }}</strong></td>
          </tr>
        {% endfor %}
      </tbody>
      <tfoot role="rowgroup" id="checkout-total" class="table-light">
        {% for total in totals %}
          <tr role="row">
            <td role="cell" colspan="4" class="text-end"><strong>{{ total.title }}</strong></td>
            <td role="cell" class="text-end">{{ total.text }}</td>
          </tr>
        {% endfor %}
      </tfoot>
    </table>
  </div>

  {% if modules %}
    <div class="p-3 p-md-4 bg-white border rounded-3 mb-4">
      <h2 class="h4 mb-3">{{ text_next }}</h2>
      <p>{{ text_next_choice }}</p>
      <div id="accordion" class="accordion">
        {% for module in modules %}
          {{ module }}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="row g-2 align-items-center mt-4">
    <div class="col-12 col-sm-6"><a href="{{ continue }}" class="btn btn-light w-100">{{ button_shopping }}</a></div>
    <div class="col-12 col-sm-6 text-end"><a href="{{ checkout }}" class="btn btn-primary w-100">{{ button_checkout }}</a></div>
  </div>
{% else %}
  <h1 class="mb-4">{{ heading_title }}</h1>
  <div class="p-4 p-md-5 bg-white border rounded-3">
    <p class="mb-4" role="status">{{ text_no_results }}</p>
    <div class="text-end"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
  </div>
{% endif %}
