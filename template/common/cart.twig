{% set lb_cart_quantity = 0 %}
{% for product in products %}
  {% set lb_cart_quantity = lb_cart_quantity + product.quantity %}
{% endfor %}
<div class="dropdown d-grid lb-mini-cart">
  <style>
/* Mini-cart only: preserve Bootstrap positioning, counter and AJAX contracts. */
#cart > .lb-mini-cart > .dropdown-menu { width: min(440px, calc(100vw - 2rem)); min-width: 0; max-width: calc(100vw - 2rem); }
#cart .lb-mini-cart .lb-mini-cart-products { width: 100%; table-layout: fixed; }
#cart .lb-mini-cart .lb-mini-cart-products td { padding: .5rem .25rem; vertical-align: top; }
#cart .lb-mini-cart .lb-mini-cart-image { width: 56px; }
#cart .lb-mini-cart .lb-mini-cart-products .img-thumbnail { width: 48px; height: 48px; min-width: 0; max-width: 48px; object-fit: contain; }
#cart .lb-mini-cart .lb-mini-cart-description { min-width: 0; overflow-wrap: anywhere; }
#cart .lb-mini-cart .lb-mini-cart-description > a { display: inline-block; color: var(--lb-ink); font-weight: 600; line-height: 1.4; }
#cart .lb-mini-cart .lb-mini-cart-description small { display: block; font-size: .75rem; line-height: 1.5; }
#cart .lb-mini-cart .lb-mini-cart-line-price { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .25rem .5rem; margin: .35rem 0; font-size: .85rem; }
#cart .lb-mini-cart .lb-mini-cart-line-price > span:last-child { max-width: 100%; font-weight: 650; overflow-wrap: anywhere; }
#cart .lb-mini-cart .lb-mini-cart-remove { width: 52px; }
#cart .lb-mini-cart .lb-mini-cart-remove .btn { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: .5rem; }
#cart .lb-mini-cart .lb-mini-cart-totals { width: 100%; table-layout: fixed; }
#cart .lb-mini-cart .lb-mini-cart-totals td { overflow-wrap: anywhere; }
#cart .lb-mini-cart .lb-mini-cart-totals td:first-child { width: 60%; }
#cart .lb-mini-cart .lb-mini-cart-actions > a { display: flex; align-items: center; justify-content: center; min-height: 44px; white-space: normal; overflow-wrap: anywhere; }
  </style>
  <button type="button" data-bs-toggle="dropdown" class="btn btn-lg btn-dark d-block dropdown-toggle" aria-label="{{ text_items }}" aria-expanded="false"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i> <span class="d-none d-lg-inline" aria-hidden="true">{{ text_items }}</span><span class="badge bg-primary ms-1 d-lg-none" aria-hidden="true">{{ lb_cart_quantity }}</span></button>
  <ul class="dropdown-menu dropdown-menu-end p-2">
    {% if products %}
      <li>
        <table class="table table-striped mb-2 lb-mini-cart-products">
          {% for product in products %}
            <tr>
              <td class="text-center lb-mini-cart-image">{% if product.thumb %}<a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-thumbnail"/></a>{% endif %}</td>
              <td class="lb-mini-cart-description"><a href="{{ product.href }}">{{ product.name }}</a>
                <div class="lb-mini-cart-line-price"><span class="text-nowrap">x {{ product.quantity }}</span><span class="text-end">{{ product.total }}</span></div>
                <ul class="list-unstyled mb-0">
                  <li>
                    <small> - {{ text_model }}: {{ product.model }}</small>
                  </li>
                  {% for option in product.option %}
                    <li>
                      <small> - {{ option.name }}: {{ option.value }}</small>
                    </li>
                  {% endfor %}
                  {% if product.subscription %}
                    <li>
                      <small> - {{ text_subscription }}: {{ product.subscription }}</small>
                    </li>
                  {% endif %}
                  {% if product.reward %}
                    <li>
                      <small> - {{ text_points }}: {{ product.reward }}</small>
                    </li>
                  {% endif %}
                </ul>
              </td>
              <td class="text-end lb-mini-cart-remove">
                <form action="{{ remove }}" method="post" data-oc-toggle="ajax" data-oc-load="{{ list }}" data-oc-target="#cart">
                  <input type="hidden" name="key" value="{{ product.cart_id }}">
                  <button type="submit" data-bs-toggle="tooltip" title="{{ button_remove }}" aria-label="{{ button_remove }}: {{ product.name }}" class="btn btn-danger"><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i></button>
                </form>
              </td>
            </tr>
          {% endfor %}
        </table>
        <div>
          <table class="table table-sm table-bordered mb-2 lb-mini-cart-totals">
            {% for total in totals %}
              <tr>
                <td class="text-end"><strong>{{ total.title }}</strong></td>
                <td class="text-end">{{ total.text }}</td>
              </tr>
            {% endfor %}
          </table>
          <div class="d-grid gap-2 lb-mini-cart-actions">
            <a href="{{ cart }}" class="btn btn-light"><strong><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i> {{ text_cart }}</strong></a>
            <a href="{{ checkout }}" class="btn btn-primary"><strong><i class="fa-solid fa-share" aria-hidden="true"></i> {{ text_checkout }}</strong></a>
          </div>
        </div>
      </li>
    {% else %}
      <li class="text-center p-4">{{ text_no_results }}</li>
    {% endif %}
  </ul>
</div>