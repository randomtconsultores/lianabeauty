{{ header }}
<style>
/* Home layout only; preserve module markup and horizontal carousel gestures. */
#common-home #content { min-width: 0; max-width: 100%; }
#common-home .lb-hero { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
#common-home .lb-hero > * { min-width: 0; max-width: 100%; }
#common-home .lb-hero-copy { overflow-wrap: anywhere; }
#common-home :is(#lb-selection, .lb-modules) { min-width: 0; max-width: 100%; }
@media (max-width: 767.98px) {
  #common-home { overflow-x: clip; }
  #common-home .lb-hero { grid-template-columns: minmax(0, 1fr); }
  #common-home .lb-modules > .row { margin-left: 0; margin-right: 0; }
}
</style>
{% set has_modules = (content_top|trim != '') or (content_bottom|trim != '') %}
<div id="common-home" class="container">
  <div class="row">{{ column_left }}
    <div id="content" class="col">
      <section class="lb-hero mb-4 rounded-3 overflow-hidden" aria-labelledby="lb-hero-title">
        <div class="lb-hero-copy">
          <p class="lb-eyebrow">Liana Beauty / Perfumes e beleza</p>
          <h1 id="lb-hero-title">A tua essência.<br><em>A tua presença.</em></h1>
          <p>O perfume que te acompanha. A beleza que fazes tua.</p>
          {% if has_modules %}
            <a class="btn btn-primary" href="#lb-selection">Explora a seleção</a>
          {% endif %}
        </div>
        <div class="align-self-center" style="min-width: 0;">
          <img src="image/catalog/home-campanha.png" alt="LianaBeauty — perfumes e beleza, com ilustração da marca em tons de rosa." class="d-block img-fluid w-100" fetchpriority="high" decoding="async"/>
        </div>
      </section>
      {% if has_modules %}
        <section id="lb-selection" tabindex="-1" aria-label="Produtos e campanhas">
          {% if content_top|trim %}
            <div id="lb-home-content-top" class="lb-modules{% if content_bottom|trim %} mb-5{% endif %}">{{ content_top }}</div>
          {% endif %}
          {% if content_bottom|trim %}
            <div id="lb-home-content-bottom" class="lb-modules">{{ content_bottom }}</div>
          {% endif %}
        </section>
      {% endif %}
    </div>
    {{ column_right }}</div>
</div>
{{ footer }}