<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{ title }}</title>
  <base href="{{ base }}"/>
  {% if description %}
    <meta name="description" content="{{ description }}"/>
  {% endif %}
  {% if keywords %}
    <meta name="keywords" content="{{ keywords }}"/>
  {% endif %}
  <script src="{{ jquery }}" type="text/javascript"></script>
  <link href="{{ bootstrap }}" type="text/css" rel="stylesheet" media="screen"/>
  <link href="{{ icons }}" rel="stylesheet" type="text/css"/>
  <link href="{{ stylesheet }}" type="text/css" rel="stylesheet"/>
  <script src="catalog/view/javascript/common.js" type="text/javascript"></script>
  {% if icon %}
    <link rel="icon" href="{{ icon }}" type="image/png">
  {% endif %}
  {% for style in styles %}
    <link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}"/>
  {% endfor %}
  {% for script in scripts %}
    <script src="{{ script.href }}" type="text/javascript"></script>
  {% endfor %}
  {% for link in links %}
    <link href="{{ link.href }}" rel="{{ link.rel }}"/>
  {% endfor %}
  {% for analytic in analytics %}
    {{ analytic }}
  {% endfor %}
  <style>
/* Responsive header panels; global storefront stylesheet remains unchanged. */
@media (min-width: 992px) {
  #top.offcanvas-lg { background: #fff !important; }
  #top > .offcanvas-body, #lb-mobile-navigation > .offcanvas-body { display: block; }
}
@media (max-width: 991.98px) {
  #container > header { padding: .4rem 0 .65rem; }
  #container > header > .container > .lb-header-row { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto 44px; gap: .5rem; margin-inline: 0; }
  #container > header .lb-header-row > div { width: auto; max-width: none; min-width: 0; padding: 0; }
  .lb-header-row > .lb-menu-slot { grid-area: 1 / 1; align-self: center; }
  .lb-header-row > .lb-logo-slot { grid-area: 1 / 2; align-self: center; }
  .lb-header-row > #cart { grid-area: 1 / 3; align-self: center; margin: 0 !important; }
  .lb-header-row > .lb-account-slot { grid-area: 1 / 4; align-self: center; }
  .lb-header-row > .lb-search-slot { grid-area: 2 / 1 / 3 / 5; }
  .lb-header-control { display: inline-flex; align-items: center; justify-content: center; width: 44px; min-height: 44px; padding: .5rem; }
  #container > header #logo { margin: 0; text-align: left; }
  #container > header #logo img { width: 140px !important; max-width: 100% !important; height: auto !important; }
  #container > header #logo .lb-wordmark { font-size: 1.35rem; }
  #container > header #cart > .dropdown > .btn { width: auto; min-width: 56px; min-height: 44px; padding: .5rem; font-size: 1rem; white-space: nowrap; }
  #container > header #search { margin-bottom: 0; }
  #container > header #search .form-control { min-height: 44px; font-size: 16px; }
  #container > header #search .btn { min-height: 44px; padding-inline: 1rem; }
  #container > #top { position: fixed; top: 0; bottom: 0; right: 0; left: auto; margin: 0; padding: 0; --bs-offcanvas-width: min(360px, 90vw); }
  #top .offcanvas-body > .container { padding: 0; }
  #top .row { display: block; margin: 0; }
  #top .row > div { width: 100%; padding: 0; text-align: left !important; }
  #top .list-inline { display: grid; gap: .25rem; }
  #top .row > div:first-child .list-inline { display: flex; flex-wrap: wrap; margin-bottom: 1rem; }
  #top .list-inline-item { margin: 0; }
  #top .list-inline-item > a, #top .list-inline-item .dropdown > a { display: block; min-height: 44px; padding: .5rem; line-height: 1.6; }
  #top .d-lg-inline { display: inline !important; }
  #top .dropdown-menu { position: static !important; transform: none !important; width: 100%; }
  #lb-mobile-navigation { --bs-offcanvas-width: min(360px, 90vw); }
  #lb-mobile-navigation .container { max-width: 100%; padding: 0; }
  #lb-mobile-navigation #menu { background: #fff !important; border: 0; padding: 0; margin: 0; }
  #lb-mobile-navigation #category, #lb-mobile-navigation #menu > .navbar-toggler { display: none !important; }
  #lb-mobile-navigation #navbar-menu { display: block !important; }
  #lb-mobile-navigation #menu .navbar-nav { width: 100%; }
  #lb-mobile-navigation #menu .navbar-nav > li > a { display: block; width: 100%; padding: .75rem; color: var(--lb-ink); border-bottom: 1px solid var(--lb-line); }
  #lb-mobile-navigation #menu .dropdown-item { color: var(--lb-ink); }
  #lb-mobile-navigation #menu a:hover, #lb-mobile-navigation #menu a:focus-visible { background-color: var(--lb-blush); color: var(--lb-ink); }
  #top .offcanvas-header .btn-close, #lb-mobile-navigation .offcanvas-header .btn-close { min-width: 44px; min-height: 44px; padding: .5rem; margin: 0 0 0 auto; }
}
  </style>
</head>
<body>
<div id="container">
  <a class="lb-skip" href="#content">Saltar para o conteúdo</a>
  <div id="alert" aria-live="polite"></div>
  <nav id="top" class="offcanvas-lg offcanvas-end" tabindex="-1" aria-labelledby="lb-preferences-title">
    <div class="offcanvas-header">
      <h2 class="offcanvas-title h5" id="lb-preferences-title">Conta e preferências</h2>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#top" aria-label="Fechar"></button>
    </div>
    <div class="offcanvas-body">
    <div class="container">
      <div class="row">
        <div class="col-4">
          <ul class="list-inline">
            <li class="list-inline-item me-3">{{ currency }}</li>
            <li class="list-inline-item">{{ language }}</li>
          </ul>
        </div>
        <div class="col text-end">
          <ul class="list-inline">
            <li class="list-inline-item"><a href="{{ contact }}"><i class="fa-solid fa-phone"></i> <span class="d-none d-lg-inline">{{ telephone }}</span></a></li>
            <li class="list-inline-item">
              <div class="dropdown">
                <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ text_account }}"><i class="fa-solid fa-user"></i> <span class="d-none d-lg-inline">{{ text_account }}</span> <i class="fa-solid fa-caret-down"></i></a>
                <ul class="dropdown-menu dropdown-menu-end">
                  {% if not logged %}
                    <li><a href="{{ register }}" class="dropdown-item">{{ text_register }}</a></li>
                    <li><a href="{{ login }}" class="dropdown-item">{{ text_login }}</a></li>
                  {% else %}
                    <li><a href="{{ account }}" class="dropdown-item">{{ text_account }}</a></li>
                    <li><a href="{{ order }}" class="dropdown-item">{{ text_order }}</a></li>
                    <li><a href="{{ transaction }}" class="dropdown-item">{{ text_transaction }}</a></li>
                    <li><a href="{{ download }}" class="dropdown-item">{{ text_download }}</a></li>
                    <li><a href="{{ logout }}" class="dropdown-item">{{ text_logout }}</a></li>
                  {% endif %}
                </ul>
              </div>
            </li>
            <li class="list-inline-item"><a href="{{ wishlist }}" id="wishlist-total" title="{{ text_wishlist }}"><i class="fa-solid fa-heart"></i> <span class="d-none d-lg-inline">{{ text_wishlist }}</span></a></li>
            <li class="list-inline-item"><a href="{{ shopping_cart }}" title="{{ text_shopping_cart }}"><i class="fa-solid fa-cart-shopping"></i> <span class="d-none d-lg-inline">{{ text_shopping_cart }}</span></a></li>
            <li class="list-inline-item"><a href="{{ checkout }}" title="{{ text_checkout }}"><i class="fa-solid fa-share"></i> <span class="d-none d-lg-inline">{{ text_checkout }}</span></a></li>
          </ul>
        </div>
      </div>
    </div>
    </div>
  </nav>
  <header>
    <div class="container">
      <div class="row lb-header-row">
        <div class="d-lg-none lb-menu-slot">
          <button type="button" class="btn btn-light lb-header-control" data-bs-toggle="offcanvas" data-bs-target="#lb-mobile-navigation" aria-controls="lb-mobile-navigation" aria-label="Menu"><i class="fa-solid fa-bars" aria-hidden="true"></i></button>
        </div>
        <div class="col-7 col-md-3 col-lg-4 order-1 lb-logo-slot">
          <div id="logo">
            {% if logo %}
              <a href="{{ home }}"><img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" class="img-fluid" style="width: 240px; max-width: 100%; height: auto; max-height: none;"/></a>
            {% else %}
              <a class="lb-wordmark" href="{{ home }}">Liana Beauty<span aria-hidden="true">.</span></a>
            {% endif %}
          </div>
        </div>
        <div id="cart" class="col-5 col-md-4 col-lg-3 mb-2 order-2 order-md-3">{{ cart }}</div>
        <div class="d-lg-none lb-account-slot">
          <button type="button" class="btn btn-light lb-header-control" data-bs-toggle="offcanvas" data-bs-target="#top" aria-controls="top" aria-label="{{ text_account }}"><i class="fa-solid fa-user" aria-hidden="true"></i></button>
        </div>
        <div class="col-12 col-md-5 order-3 order-md-2 lb-search-slot">{{ search }}</div>
      </div>
    </div>
  </header>
  <main>
    <div id="lb-mobile-navigation" class="offcanvas-lg offcanvas-start" tabindex="-1" aria-labelledby="lb-navigation-title">
      <div class="offcanvas-header">
        <h2 class="offcanvas-title h5" id="lb-navigation-title">Menu</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#lb-mobile-navigation" aria-label="Fechar"></button>
      </div>
      <div class="offcanvas-body">{{ menu }}</div>
    </div>
