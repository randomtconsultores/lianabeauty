<form action="{{ action }}" method="post" class="input-group mb-0" role="search">
	<input type="text" name="search" value="{{ search }}" placeholder="{{ text_search }}" aria-label="{{ text_search }}" class="form-control form-control-lg"/>
	<button type="submit" class="btn btn-light btn-lg" aria-label="{{ text_search }}"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
</form>
